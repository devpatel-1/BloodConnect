<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ============================== -->
    <!-- TOP HEADER -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/dashboardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BloodConnect"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#B71C1C"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/myProfileButton" />

    <!-- Profile -->

    <TextView
        android:id="@+id/myProfileButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="56dp"
        android:gravity="center"
        android:text="Profile"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingHorizontal="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/dashboardTitle"
        app:layout_constraintBottom_toBottomOf="@id/dashboardTitle"
        app:layout_constraintStart_toEndOf="@id/dashboardTitle"
        app:layout_constraintEnd_toStartOf="@id/myRequestsButton" />

    <!-- Requests -->

    <TextView
        android:id="@+id/myRequestsButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="64dp"
        android:gravity="center"
        android:text="Requests"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingHorizontal="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/dashboardTitle"
        app:layout_constraintBottom_toBottomOf="@id/dashboardTitle"
        app:layout_constraintStart_toEndOf="@id/myProfileButton"
        app:layout_constraintEnd_toStartOf="@id/logoutButton" />

    <!-- Logout -->

    <TextView
        android:id="@+id/logoutButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="56dp"
        android:gravity="center"
        android:text="Logout"
        android:textColor="#666666"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingHorizontal="6dp"
        android:layout_marginEnd="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/dashboardTitle"
        app:layout_constraintBottom_toBottomOf="@id/dashboardTitle"
        app:layout_constraintStart_toEndOf="@id/myRequestsButton"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================== -->
    <!-- WELCOME / TAGLINE -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/dashboardSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Find a donor when every second matters."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/dashboardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================== -->
    <!-- SEARCH -->
    <!-- ============================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Search donors"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="16dp"
        app:endIconMode="clear_text"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:helperText="Search by name, city, or blood group"
        app:layout_constraintTop_toBottomOf="@id/dashboardSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ============================== -->
    <!-- DONOR STATISTICS -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/statsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#555555"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/searchLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="12 donors • A+: 3  AB+: 1  O+: 5" />


    <!-- ============================== -->
    <!-- INCOMING REQUESTS -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/incomingRequestsButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="Incoming Requests  ›"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/statsText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp" />


    <!-- ============================== -->
    <!-- SECTION TITLE -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/donorSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Available Donors"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/incomingRequestsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================== -->
    <!-- EMPTY STATE -->
    <!-- ============================== -->

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No donors found yet.\nBe the first to sign up!"
        android:textAlignment="center"
        android:textSize="15sp"
        android:textColor="#888888"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================== -->
    <!-- DONOR LIST -->
    <!-- ============================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/donorRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/donorSectionTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>